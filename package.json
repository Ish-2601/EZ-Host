{
  "name": "ez-host",
  "version": "0.2.0",
  "description": "EZ Host: host Minecraft and Project Zomboid servers on your own PC so friends can join from anywhere.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "make-icon": "electron scripts/make-icon.js",
    "test:engine": "node scripts/engine-smoke.js"
  },
  "author": "Ish-2601",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "EZ Host",
  "build": {
    "appId": "com.ish2601.selfhostmc",
    "productName": "EZ Host",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "EZ Host",
      "deleteAppDataOnUninstall": false,
      "artifactName": "EZ-Host-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "src/engine/map-worker.js",
      "src/engine/map-render.js",
      "src/engine/nbt.js"
    ]
  }
}
